<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Configuration"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- WEATHER SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather Service"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="API Key"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editWeatherApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="City"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editWeatherCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MQTT SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MQTT Broker"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:id="@+id/mqttContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Broker URL"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:text="ssl://e5cd970367924076ba08be31e69e4301.s1.eu.hivemq.cloud:8883"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Username"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Password"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#1E293B"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Pump Topic"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttPumpTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:text="aquatics/pump/command"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Irrigation Topic"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttIrrigationTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:text="aquatics/irrigation/command"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Sensor Topic"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMqttSensorTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:text="aquatics/sensors/data"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTopic"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add More Topics"
                        app:icon="@android:drawable/ic_input_add"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIMER SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timers (Minutes)"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pump Timeout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPumpTimer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="number"
                            android:text="60"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Irrigation Timeout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#64748B">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editIrrigationTimer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:inputType="number"
                            android:text="30"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NOTIFICATION SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts \u0026 Notifications"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTaskNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Task Completion Alerts"
                        android:textColor="#1E293B"
                        android:checked="true"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginHorizontal="12dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchErrorNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Critical Error Alerts"
                        android:textColor="#1E293B"
                        android:checked="true"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginHorizontal="12dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotificationSound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Notification Sound"
                        android:textColor="#1E293B"
                        android:checked="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SENSOR TOGGLES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enabled Sensors"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSoilSensor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Soil Moisture Sensor"
                        android:textColor="#1E293B"
                        android:checked="true"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginHorizontal="12dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLevelSensor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Water Level Sensor"
                        android:textColor="#1E293B"
                        android:checked="true"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginHorizontal="12dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFlowSensor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Water Flow Sensor"
                        android:textColor="#1E293B"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Configuration"
                app:cornerRadius="16dp"
                android:backgroundTint="#3B82F6"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
