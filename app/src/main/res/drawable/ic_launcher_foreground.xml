<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Shadow for the drop -->
    <path android:pathData="M54,25 C54,25 30,55 30,72 A24,24 0 0 0 78,72 C78,55 54,25 54,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="78"
                android:endY="96"
                android:startX="30"
                android:startY="25"
                android:type="linear">
                <item android:color="#22000000" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Water Drop Gradient -->
    <path android:pathData="M54,22 C54,22 28,54 28,73 A26,26 0 0 0 80,73 C80,54 54,22 54,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="54"
                android:endY="99"
                android:startX="54"
                android:startY="22"
                android:type="linear">
                <item android:color="#4FC3F7" android:offset="0.0" /> <!-- Light Blue -->
                <item android:color="#0288D1" android:offset="1.0" /> <!-- Dark Blue -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Propeller / Smart Icon -->
    <group
        android:pivotX="54"
        android:pivotY="70">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,60 L58,70 L54,80 L50,70 Z M44,70 L54,66 L64,70 L54,74 Z" />
        <path
            android:fillColor="#80FFFFFF"
            android:pathData="M54,55 A15,15 0 1 1 53.9,55 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFF" />
    </group>

    <!-- Glossy Highlight -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M42,45 C42,45 35,55 35,65"
        android:strokeWidth="3"
        android:strokeColor="#66FFFFFF"
        android:strokeLineCap="round" />

</vector>